{
  "name": "@plumbox/client",
  "version": "0.4.0",
  "description": "Client SDK for Plum Box: log in once, auto-connect to the user's box via Plum Relay, and use the Drive API — no IP, port, or tunneling knowledge required.",
  "license": "MIT",
  "keywords": [
    "plum",
    "plumbox",
    "plum-box",
    "sdk",
    "client",
    "drive",
    "self-hosted",
    "oauth",
    "pkce"
  ],
  "homepage": "https://github.com/plum-networks/plum-sdk/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plum-networks/plum-sdk.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/plum-networks/plum-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "PLUM_INTEGRATION=1 vitest run test/integration.test.ts"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
